<div class="max-w-2xl mx-auto mt-10 text-center">
  <h1 class="text-4xl font-bold mb-6">Welcome to Chirpboard</h1>
  
  <% if logged_in? %>
    <div class="mb-4">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar.variant(:thumb), class: "w-20 h-20 rounded-full mx-auto object-cover border-2 border-blue-500" %>
      <% else %>
        <div class="w-20 h-20 rounded-full mx-auto bg-gray-300 flex items-center justify-corner text-gray-600">
          No Img
        </div>
      <% end %>
    </div>
    <p class="text-xl mb-4">Hello, <%= current_user.name %>!</p>
    <% @posts.each do |post| %>
      <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
        <div class="flex items-center space-x-2 mb-1">
          <span class="font-bold"><%= post.user.name %></span>
          <span class="text-gray-500 text-sm">@<%= post.user.username %> · <%= time_ago_in_words(post.created_at) %> ago</span>
        </div>
        
        <p class="text-gray-800"><%= post.body %></p>
        
        <% if current_user == post.user %>
          <div class="mt-2 border-t pt-2">
            <%= link_to "Delete Post", post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this?" }, class: "text-red-500 text-sm hover:text-red-700 font-medium" %>
          </div>
        <% end %>
      </div>
    <% end %>
    
    
  
  <% else %>
    <div class="space-x-4">
      <%= link_to "Log In", login_path, class: "text-blue-600 hover:underline" %>
      <%= link_to "Sign Up", signup_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
    </div>
  <% end %>

  <%= link_to new_post_path, class: "fixed bottom-8 right-8 bg-blue-500 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:bg-blue-600 hover:scale-110 transition transform text-4xl pb-2" do %>
    +
  <% end %>
</div>