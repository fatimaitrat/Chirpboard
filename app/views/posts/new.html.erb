<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-md border border-gray-200">
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold">New Post</h1>
        <%= link_to "Cancel", root_path, class: "text-gray-500 hover:text-gray-700" %>
    </div>

    <%= form_with(model: @post, url: posts_path, local: true) do |f|%>
        <div class="flex space-x-4">
            <% if current_user.avatar.attached? %>
                <% if current_user.avatar.content_type.to_s.include?("svg") %>
                    <%= image_tag current_user.avatar, class: "w-10 h-10 rounded-full object-cover" %>
                <% else %>
                  <%= image_tag current_user.avatar.variant(:thumb), class: "w-10 h-10 rounded-full object-cover" %>
                <% end %>
            <% else %>
                <div class="w-10 h-10 rounded-full bg-gray-300"></div>
            <% end%>
            <div class="flex-1">
                <%= f.label :body, "Body", class: "sr-only" %> 
                
                <%= f.text_area :body, placeholder: "What's happening?", rows: 4, autofocus: true, class: "w-full border-none focus:ring-0 text-lg resize-none placeholder-gray-400" %>
            </div>
        </div>

        <div class="flex justify-end mt-4 border-t pt-4">
            <%= f.submit "Post", class: "bg-blue-500 text-white px-6 py-2 rounded-full font-bold hover:bg-blue-600 cursor-pointer"%>
        </div>
    <% end %>
</div>