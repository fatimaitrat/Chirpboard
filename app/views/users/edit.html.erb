<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-md border border-gray-200">
    <h1 class="text-2xl font-bold mb-6">Edit Profile</h1>
    <% if @user.errors.any? %>
        <div class="bg-red-50 text-red-500 p-4 mb-6 rounded-lg border border-red-200">
        <h2 class="font-bold mb-2"><%= pluralize(@user.errors.count, "error") %> prevented this profile from saving:</h2>
        <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
            <% end %>
        </ul>
        </div>
    <% end %>
    <%=  form_with model: @user, url: user_path(@user), method: :patch, local: true do |f|%>
        <div class="mb-4 text-center">
            <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar.variant(:thumb), class: "w-20 h-20 rounded-full mx-auto mb-2 object-cover"%>
                <div class="mb-2">
                    <%= link_to "Remove Photo", destroy_user_avatar_path, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-500 text-xs hover:underline" %>
                </div>
            <% end %>
            <%= f.label :avatar, "Change Profile Picture", class: "block text-sm font-bold text-gray-700 mb-1"%>
            <%= f.file_field :avatar,class: "hidden"%>
        </div>

        <div class="mb-4">
            <%= f.label :bio, class: "block text-sm font-bold text-gray-700"%>
            <%= f.text_area :bio,rows: 3, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500"%>
        </div>

        <div class="flex justify-end space-x-3">
            <%= link_to "Cancel", user_profile_path(@user.username), class: "px-4 py-2 text-gray-600 hover:text-gray-800" %>
            <%= f.submit "Save Changes", class: "bg-blue-500 text-white px-4 py-2 rounded font-blue hover:bg-blue-600 cursor-pointer" %>
        </div>
    <% end %>
</div>