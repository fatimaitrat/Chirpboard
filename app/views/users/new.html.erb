<div class="mx-w-md mx-auto mt-10">
    <h1 class = "text-3xl font-bold mb-6">Sign Up</h1>

    <% if @user.errors.any? %>
        <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
            <ul>
                <% @user.errors.full_messages.each do |msg|%>
                    <li>• <%= msg %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <%= form_with model: @user, local: true, class: "space-y-4" do |f|%>
        <div>
            <%= f.label :name, class:"block font-medium" %>
            <%= f.text_field :name,class: "w-full border p-2 rounded"%>
        </div>

        <div>
            <%= f.label :username, class:"block font-medium" %>
            <%= f.text_field :username,class: "w-full border p-2 rounded"%>
        </div>

        <div>
            <%= f.label :avatar, "Profile Picture", class: "block font-medium" %>
            <%= f.file_field :avatar, class: "w-full"%>
        </div>
        <div>
            <%= f.label :email, class:"block font-medium" %>
            <%= f.email_field :email,class: "w-full border p-2 rounded"%>
        </div>

        <div>
            <%= f.label :password, class:"block font-medium" %>
            <%= f.password_field :password,class: "w-full border p-2 rounded"%>
        </div>

        <div>
            <%= f.label :password_confirmation, "Confirm Password", class:"block font-medium" %>
            <%= f.password_field :password_confirmation,class: "w-full border p-2 rounded"%>
        </div>

        <%= f.submit "Create Account", class: "w-full bg-green-500 text-white p-2 rounded hover:bg-green-600 cursor-pointer" %>
    <% end %>
</div>