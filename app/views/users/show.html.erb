<div class="max-w-2xl mx-auto mt-10">
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
        <div class="flex item-start justify-between ">
            <div class=" flex items-center space-x-4">
                <% if @user.avatar.attached? %>
                    <%= image_tag @user.avatar.variant(:medium), class: "w-24 h-24 rounded-full object-cover border-4 border-white shadow-md"%>
                <% else %>
                    <div class="w-24 h-24 rounded-full bg-gray-300 flex items-center justify-center text-gray-500 text-2xl font-bold">
                        <%= @user.username[0]%>
                    </div>
                <% end %>

                <div>
                    <h1 class="text-2xl font-bold"><%= @user.name%></h1>
                    <p class="text-gray-500">@<%= @user.username %></p>
                </div>
            </div>


            <% if current_user == @user %>
                <div class="mt-4 space-x-2">
                    <%= link_to "Edit Profile", edit_user_path(@user), class: "bg-gray-200 text-gray-800 px-4 py-2 rounded inline-block hover:bg-gray-300 transition" %>
    
                     <%= link_to "Logout", logout_path, data: { turbo_method: :delete }, class: "bg-red-500 text-white px-4 py-2 rounded inline-block hover:bg-red-600 transition" %>
                </div>
            <% else %>
                <% if current_user.following?(@user)%>
                    <%= button_to "Unfollow", follow_path(@user), method: :delete, class: "bg-white text-black border border-gray-300 px-4 py-2 rounded-full font-bold text-sm hover:bg-gray-100" %>
                <% else %>
                    <%= button_to "Follow", follows_path(followed_id: @user.id), method: :post, class: "bg-black text-white px-4 py-2 rounded-full font-bold text-sm hover:bg-gray-800" %>
                <% end %>
            <% end %>

        </div>

        <p class="mt-4 text-gray-800"><%= @user.bio %></p>
        <div class="flex space-x-6 mt-4 text-sm text-gray-600">
            <div>
                <span class="font-bold text-black"><%= @user.following.count %></span>Following
            </div>
            <div>
                <span class="font-bold text-black"><%= @user.followers.count %></span> Followers
            </div>
        </div>
    </div>

    <h2 class="text-xl font-bold mb-4">Posts</h2>
    <div class="space-y-4">
        <% if @user.posts.any? %>
            <% @user.posts.order(created_at: :desc).each do |post|%>
                <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
                    <div class="flex items-center space-x-2 mb-2">
                        <span class="font-bold"><%= @user.name%></span>
                        <span class="text-gray-500 text-sm">@<%= @user.username %> · <%= time_ago_in_words(post.created_at) %>ago</span>
                    </div>
                    <p class="text-gray-800"><%= post.body %></p>
                </div>
            <% end %>
        <% else%>
            <div class="text-center text-gray-500 py-10">
                This user hasn't posted anything yet.
            </div>
        <% end %>
    </div>
</div>